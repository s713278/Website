# MithraDirect API
VITE_API_BASE_URL=https://subscriptionapp-wgf8.onrender.com/api
VITE_APP_ENV=development

# Set true to hit real Spring Boot APIs (OTP, cart, orders)
VITE_USE_API=false

# Demo vendor id for slug→vendor mapping until GET /v1/public/stores/{slug} ships
VITE_SAMPLE_VENDOR_ID=1

# Hybrid WhatsApp: DEEPLINK (Phase 1) | CLOUD_API (Phase 2)
VITE_CHECKOUT_CHANNEL=DEEPLINK

# Local monorepo URLs
VITE_MARKETING_URL=http://localhost:5173
VITE_VENDOR_APP_URL=http://localhost:5174
VITE_STOREFRONT_URL=http://localhost:5175
