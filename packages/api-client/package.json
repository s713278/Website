{
  "name": "@mithra/api-client",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "fetch-openapi": "node ./scripts/fetch-openapi.mjs",
    "generate": "openapi-typescript ./openapi.json -o ./src/schema.d.ts",
    "sync": "node ./scripts/fetch-openapi.mjs && pnpm generate",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"lint ok\""
  },
  "dependencies": {
    "axios": "^1.7.9",
    "openapi-fetch": "^0.13.5"
  },
  "devDependencies": {
    "openapi-typescript": "^7.5.2",
    "typescript": "^5.7.3"
  }
}
